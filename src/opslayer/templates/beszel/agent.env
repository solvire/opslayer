# Beszel agent environment - rendered by opslayer monitor deploy.
# KEY / TOKEN come from the hub ("Add System"); HUB_URL is the hub address.
# These are SECRETS - they live in the operator's .env (OPSLAYER_BESZEL_KEY /
# OPSLAYER_BESZEL_TOKEN / OPSLAYER_BESZEL_HUB_URL) and are never committed.
# Rendering from .env makes `monitor deploy beszel` idempotent (no clobber).
KEY=${OPSLAYER_BESZEL_KEY}
TOKEN=${OPSLAYER_BESZEL_TOKEN}
HUB_URL=${OPSLAYER_BESZEL_HUB_URL}
LISTEN=45876
