# opslayer settings template.
# Copy to .env (repo root) and fill in; .env is gitignored and MUST NOT be committed.

OPSLAYER_OPS_HOST=            # ops controller (Pi 4) address
OPSLAYER_CLUSTER_API=         # k3s API endpoint
OPSLAYER_NUT_SERVER=          # NUT server address
OPSLAYER_NUT_UPS_NAME=        # NUT UPS block name
OPSLAYER_PIHOLE_HOST=         # Pi-hole / DNS address
OPSLAYER_TRUENAS_HOST=        # NAS address
OPSLAYER_DNS_ZONE=            # DNS zone name (e.g. example.com)
OPSLAYER_DNS_PROVIDER=route53 # DNS provider (see operations/dns/)

# Tunnel exposure (see operations/tunnel/)
OPSLAYER_TUNNEL_PROVIDER=frp # tunnel provider (default frp; cloudflare later)
OPSLAYER_FRP_SERVER=          # edge/tunnel hub address frpc dials out to
OPSLAYER_FRP_PORT=7000        # frps bindPort
OPSLAYER_FRP_TOKEN=           # shared tunnel auth token (frps auth.token) - it is
                              # injected into a k8s Secret, never versioned

# AWS credentials for the DNS provider (standard boto3 names, gitignored)
AWS_ACCESS_KEY_ID=            # least-privilege key: Route53 on one zone only
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Monitor stack (see operations/monitoring.py). opslayer deploys Gatus + nut_exporter
# + Beszel onto OPSLAYER_OPS_HOST. Values below are operator-supplied at deploy time;
# nothing here is committed. ARGOCD_API_KEY is a secret - keep it in .env only.
OPSLAYER_MONITOR_SSH_USER=sshuser # ssh user used to reach the ops controller
OPSLAYER_GATUS_PORT=8080          # Gatus dashboard listen port
OPSLAYER_NUT_EXPORTER_PORT=9199   # nut_exporter Prometheus-text listen port
OPSLAYER_ARGOCD_URL=              # ArgoCD UI base URL for the Gatus widget
OPSLAYER_ARGOCD_API_KEY=          # SECRET - ArgoCD API key (readonly user)
OPSLAYER_MONITOR_ENDPOINTS=       # comma-separated URLs for Gatus to health-check
OPSLAYER_BESZEL_KEY=              # SECRET - hub "Add System" public key for the agent
OPSLAYER_BESZEL_TOKEN=            # SECRET - hub "Add System" token for the agent
OPSLAYER_BESZEL_HUB_URL=http://127.0.0.1:8090  # hub address as seen by the agent
OPSLAYER_BESZEL_PORT=8090         # hub HTTP port (API + UI)
OPSLAYER_BESZEL_ADMIN_EMAIL=      # hub admin email; `monitor beszel-init` prompts + writes this
OPSLAYER_BESZEL_ADMIN_PASSWORD=   # SECRET - hub admin password; created via API on a fresh hub
